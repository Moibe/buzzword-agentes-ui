# Copiar este archivo como .env.development, .env.staging o .env.production
# y reemplazar con las URLs reales de cada ambiente.

VITE_API_URL=http://localhost:8077

# Puertos (los lee vite.config.js al arrancar `vite preview` / `vite dev`).
# Prod en CSI: UI 4175 → API 8077. Instancia dev: PORT=4178, API_PORT=8078.
PORT=4175
API_PORT=8077

# Puerto de los widgets (host-asistentes) que abren Sandbox, MiniAdmin y el chip
# "embebido". Se fija al compilar. Prod: 4176 (default). Instancia dev: 4179.
VITE_HOST_ASISTENTES_PORT=4176
